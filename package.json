{
  "name": "mohamed-lakhel-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Systems, shipped: the bilingual engineering portfolio of Mohamed Lakhel.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-pdf.mjs",
    "build:site": "astro build",
    "pdf": "node scripts/build-pdf.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "linkcheck": "node scripts/check-links.mjs",
    "content:check": "node scripts/content-check.mjs",
    "size": "node scripts/js-size-report.mjs",
    "lhci": "lhci autorun",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm linkcheck && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "6.4.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "geist": "1.9.0",
    "globals": "16.5.0",
    "node-html-parser": "9.0.6",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "satori": "0.63.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
