---
/**
 * The single 404 page GitHub Pages serves for every missing URL, so it is
 * bilingual: English first, German below with lang="de". Links are absolute
 * (base path included) because the page is served at arbitrary paths.
 */
import { pageMeta } from '../../i18n/meta.copy.ts';
import { routeHref } from '../../i18n/routes.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ogImagePath } from '../../lib/og.ts';

const en = pageMeta.en.notFound;
const de = pageMeta.de.notFound;
---

<BaseLayout
  locale="en"
  title={`${en.title} · ${de.title}`}
  description={`${en.description} ${de.description}`}
  path={null}
  ogImage={ogImagePath('en', 'not-found')}
  noindex
>
  <div class="container not-found">
    <p class="label">
      <span>404</span>
    </p>
    <div class="not-found__grid">
      <section aria-labelledby="nf-en" lang="en">
        <h1 id="nf-en">{en.title}</h1>
        <p class="muted">The address may be mistyped, or the page has moved.</p>
        <ul role="list" class="not-found__links">
          <li>
            <a href={routeHref('en', 'home')}>Go to the home page</a>
          </li>
          <li>
            <a href={routeHref('en', 'work')}>See the work</a>
          </li>
          <li>
            <a href={routeHref('en', 'cv')}>Read the CV</a>
          </li>
        </ul>
      </section>
      <section aria-labelledby="nf-de" lang="de">
        <h2 id="nf-de">{de.title}</h2>
        <p class="muted">
          Die Adresse ist vielleicht falsch geschrieben, oder die Seite ist umgezogen.
        </p>
        <ul role="list" class="not-found__links">
          <li>
            <a href={routeHref('de', 'home')}>Zur Startseite</a>
          </li>
          <li>
            <a href={routeHref('de', 'work')}>Zu den Projekten</a>
          </li>
          <li>
            <a href={routeHref('de', 'cv')}>Zum Lebenslauf</a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  .not-found__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6) var(--grid-gutter);
  }

  .not-found__grid section {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--color-line);
  }

  .not-found__grid h2 {
    font-size: var(--step-5);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .not-found__links {
    display: grid;
    gap: var(--space-1);
  }
</style>
