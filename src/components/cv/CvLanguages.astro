---
/**
 * Languages with their levels (src/data/skills.ts) as a definition list:
 * language above level, four across from 40rem and in print, two on phones.
 */
import { languages } from '../../data/skills.ts';
import type { Locale } from '../../i18n/config.ts';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
---

<dl class:list={['cv-languages', className]}>
  {languages.map((language) => (
    <div class="cv-languages__item">
      <dt class="cv-languages__name">{language.name[locale]}</dt>
      <dd class="cv-languages__level">{language.level[locale]}</dd>
    </div>
  ))}
</dl>

<style>
  .cv-languages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--grid-gutter);
  }

  .cv-languages__item {
    display: grid;
    gap: var(--space-half);
    align-content: start;
  }

  .cv-languages__name {
    font-weight: var(--weight-medium);
  }

  .cv-languages__level {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .cv-languages {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media print {
    .cv-languages {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 var(--space-2);
      break-inside: avoid;
    }

    .cv-languages__item {
      gap: 0;
    }

    .cv-languages__level {
      color: var(--color-text-muted);
    }
  }
</style>
