---
/**
 * The performance budget of brief section 10 as a real table: metric (row
 * header), target, how it is measured and the measured value, which stays a
 * visible placeholder until it is recorded at launch. Rows are grouped into
 * "every page" and the planned 3D stage (each group has a row-group header).
 * Below 48rem every row becomes a stacked block with inline labels; those
 * labels are aria-hidden because the column headers already name each cell.
 */
import type { ColophonCopy } from '../../views/colophon/colophon.copy.ts';
import Rich from '../ui/Rich.astro';

interface Props {
  copy: ColophonCopy['budgets'];
}

const { copy } = Astro.props;
const cols = copy.columns;
---

<div class="budgets">
  <table class="budgets__table">
    <caption class="visually-hidden">{copy.caption}</caption>
    <colgroup>
      <col class="budgets__col budgets__col--metric" />
      <col class="budgets__col budgets__col--target" />
      <col class="budgets__col budgets__col--with" />
      <col class="budgets__col budgets__col--measured" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">{cols.metric}</th>
        <th scope="col">{cols.target}</th>
        <th scope="col">{cols.measuredWith}</th>
        <th scope="col">{cols.measured}</th>
      </tr>
    </thead>
    {copy.groups.map((group) => (
      <tbody>
        <tr class="budgets__group">
          <th colspan="4" scope="rowgroup">
            {group.title}
          </th>
        </tr>
        {group.rows.map((row) => (
          <tr class="budgets__row">
            <th scope="row" class="budgets__metric">
              {row.metric}
            </th>
            <td class="budgets__target">
              <span class="budgets__label" aria-hidden="true">
                {cols.target}
              </span>
              <span>{row.target}</span>
            </td>
            <td class="budgets__with">
              <span class="budgets__label" aria-hidden="true">
                {cols.measuredWith}
              </span>
              <span>{row.measuredWith}</span>
            </td>
            <td class="budgets__measured">
              <span class="budgets__label" aria-hidden="true">
                {cols.measured}
              </span>
              <span>
                <Rich text={copy.measuredPlaceholder} />
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
  <p class="budgets__note">{copy.footnote}</p>
</div>

<style>
  .budgets__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .budgets__table th,
  .budgets__table td {
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    border-top: var(--hairline) solid var(--color-line);
    text-align: left;
    vertical-align: baseline;
  }

  .budgets__table thead th {
    padding-block: var(--space-1);
    border-top: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .budgets__group th {
    padding-top: var(--space-4);
    border-top-color: var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .budgets__metric {
    font-weight: var(--weight-medium);
  }

  .budgets__target {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.01em;
  }

  .budgets__with {
    color: var(--color-text-muted);
  }

  .budgets__measured {
    color: var(--color-text-muted);
  }

  .budgets__table tbody:last-of-type tr:last-child > * {
    border-bottom: var(--hairline) solid var(--color-line);
  }

  .budgets__label {
    display: none;
  }

  .budgets__note {
    max-width: var(--measure);
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .budgets__col--metric {
      width: 26%;
    }

    .budgets__col--target {
      width: 30%;
    }

    .budgets__col--with {
      width: 22%;
    }

    .budgets__col--measured {
      width: 22%;
    }
  }

  /* Narrow screens: one stacked block per row, labels shown inline. */
  @media (max-width: 47.99rem) {
    .budgets__table,
    .budgets__table tbody,
    .budgets__table tr,
    .budgets__table th,
    .budgets__table td {
      display: block;
    }

    .budgets__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .budgets__table th,
    .budgets__table td {
      padding: 0;
      border: 0;
    }

    .budgets__group th {
      padding-top: var(--space-4);
      padding-bottom: var(--space-1);
    }

    .budgets__row {
      display: grid;
      gap: var(--space-half);
      padding-block: var(--space-2);
      border-top: var(--hairline) solid var(--color-line);
    }

    .budgets__table tbody:last-of-type tr:last-child > * {
      border-bottom: 0;
    }

    .budgets__table tbody:last-of-type .budgets__row:last-child {
      border-bottom: var(--hairline) solid var(--color-line);
    }

    .budgets__row > td {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--space-2);
      align-items: baseline;
    }

    .budgets__label {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--step--2);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-subtle);
    }
  }
</style>
