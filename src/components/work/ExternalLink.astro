---
/**
 * A link that leaves the site: same tab, arrow-up-right icon, and visually
 * hidden "(external link)" text, so the accessible name contains the visible
 * label plus the warning.
 */
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config.ts';
import { ui } from '../../i18n/ui.copy.ts';

interface Props {
  href: string;
  locale: Locale;
  class?: string;
}

const { href, locale, class: className } = Astro.props;
---

<a class:list={['ext-link', className]} href={href}>
  <slot />
  <Icon name="arrow-up-right" size={14} class="ext-link__icon" />
  <span class="visually-hidden">{ui[locale].externalLink}</span>
</a>

<style>
  .ext-link :global(.ext-link__icon) {
    display: inline-block;
    margin-left: 0.2em;
    vertical-align: -0.1em;
  }
</style>
