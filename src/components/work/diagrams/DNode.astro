---
/**
 * A box in an architecture diagram: a hairline rectangle with a mono title and
 * up to two sub-labels. 'center' and 'start' stack the lines vertically;
 * 'split' draws a layer bar with the title on the left and one sub-label on the
 * right. Styles live in DiagramFrame.astro.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  title2?: string;
  sub?: string;
  sub2?: string;
  align?: 'center' | 'start' | 'split';
}

const { x, y, w, h, title, title2, sub, sub2, align = 'center' } = Astro.props;

const PAD = 12;
const TITLE_LINE = 16;
const SUB_LINE = 15;

type Line = { text: string; className: string; height: number };
const lines: Line[] = [
  { text: title, className: 'd-title', height: TITLE_LINE },
  ...(title2 ? [{ text: title2, className: 'd-title', height: TITLE_LINE }] : []),
  ...(sub ? [{ text: sub, className: 'd-sub', height: SUB_LINE }] : []),
  ...(sub2 ? [{ text: sub2, className: 'd-sub', height: SUB_LINE }] : []),
];

const total = lines.reduce((sum, line) => sum + line.height, 0);
let cursor = y + (h - total) / 2;
const placed = lines.map((line) => {
  const center = cursor + line.height / 2;
  cursor += line.height;
  return { ...line, y: center };
});

const textX = align === 'center' ? x + w / 2 : x + PAD;
const anchor = align === 'center' ? 'middle' : 'start';
---

<g class:list={['d-node', `d-node--${align}`]}>
  <rect x={x} y={y} width={w} height={h} rx="2"></rect>
  {align === 'split' ? (
    <>
      <text class="d-title" x={x + PAD} y={y + h / 2} dominant-baseline="central">
        {title}
      </text>
      {sub && (
        <text
          class="d-sub"
          x={x + w - PAD}
          y={y + h / 2}
          text-anchor="end"
          dominant-baseline="central"
        >
          {sub}
        </text>
      )}
    </>
  ) : (
    placed.map((line) => (
      <text
        class={line.className}
        x={textX}
        y={line.y}
        text-anchor={anchor}
        dominant-baseline="central"
      >
        {line.text}
      </text>
    ))
  )}
</g>
