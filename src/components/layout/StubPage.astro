---
/**
 * Temporary page body used by the foundation stubs. Each workstream replaces
 * its view with the real page; nothing should import this at the end of Phase 1.
 */
import type { Locale } from '../../i18n/config.ts';
import { pageMeta } from '../../i18n/meta.copy.ts';
import type { RouteKey } from '../../i18n/routes.ts';
import { ROUTES } from '../../i18n/routes.ts';
import { SCENE_SHOTS } from '../../data/scene.ts';
import { ogImagePath } from '../../lib/og.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const meta = pageMeta[locale][routeKey];
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  path={ROUTES[routeKey]}
  ogImage={ogImagePath(locale, routeKey)}
  sceneShot={SCENE_SHOTS[routeKey]}
>
  <div class="container stub">
    <h1>{meta.title}</h1>
    <p class="muted">{meta.description}</p>
    <p class="ph-block">[TODO: {routeKey} page body]</p>
    <slot />
  </div>
</BaseLayout>

<style>
  .stub {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-10);
  }
</style>
