---
import { EMAIL, LINKS } from '../../data/identity.ts';
import { profile } from '../../data/profile.ts';
import type { Locale } from '../../i18n/config.ts';
import { routeHref } from '../../i18n/routes.ts';
import { ui } from '../../i18n/ui.copy.ts';
import { cvPdfHref } from '../../lib/cv.ts';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getUTCFullYear();

const siteLinks = [
  { href: routeHref(locale, 'work'), label: t.nav.work },
  { href: routeHref(locale, 'experience'), label: t.nav.experience },
  { href: routeHref(locale, 'lab'), label: t.nav.lab },
  { href: routeHref(locale, 'about'), label: t.nav.about },
  { href: routeHref(locale, 'cv'), label: t.nav.cv },
  { href: routeHref(locale, 'colophon'), label: t.footer.colophon },
];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__id">
      <p class="site-footer__name">{profile.name}</p>
      <p class="subtle">{profile.role[locale]}</p>
      <p class="subtle site-footer__place">
        <Icon name="pin" size={14} />
        {profile.location.label[locale]}
      </p>
    </div>

    <nav class="site-footer__col" aria-labelledby="footer-site">
      <p class="label" id="footer-site">
        {t.footer.sitemap}
      </p>
      <ul role="list">
        {siteLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <p class="label" id="footer-contact">
        {t.footer.contact}
      </p>
      <ul role="list" aria-labelledby="footer-contact">
        <li>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
        <li>
          <ExternalLink locale={locale} href={LINKS.linkedin} rel="me">
            LinkedIn
          </ExternalLink>
        </li>
        <li>
          <ExternalLink locale={locale} href={LINKS.github} rel="me">
            GitHub
          </ExternalLink>
        </li>
        <li>
          <a href={cvPdfHref(locale)} download>
            {t.cta.downloadCvPdf}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p class="subtle">
      © {year} {profile.name}. {t.footer.builtWith}
    </p>
    <nav aria-label={t.footer.legal}>
      <ul role="list" class="site-footer__legal-links">
        <li>
          <a href={routeHref(locale, 'impressum')}>{t.footer.impressum}</a>
        </li>
        <li>
          <a href={routeHref(locale, 'datenschutz')}>{t.footer.datenschutz}</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    margin-top: var(--section-gap);
    border-top: var(--hairline) solid var(--color-line);
    font-size: var(--step--1);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4) var(--grid-gutter);
    padding-block: var(--space-8) var(--space-6);
  }

  .site-footer__id {
    grid-column: span 6;
    display: grid;
    gap: var(--space-half);
    align-content: start;
  }

  .site-footer__name {
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
  }

  .site-footer__place {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .site-footer__col {
    grid-column: span 3;
    min-width: 0;
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-half);
    margin-top: var(--space-2);
  }

  .site-footer__col a,
  .site-footer__legal a {
    display: inline-block;
    padding-block: var(--space-half);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  /* LinkedIn and GitHub: ExternalLink keeps its own inline-flex box and icon. */
  .site-footer__col :global(.ext-link) {
    padding-block: var(--space-half);
    color: var(--color-text-muted);
  }

  .site-footer__col a:hover,
  .site-footer__legal a:hover,
  .site-footer__col :global(.ext-link:hover) {
    color: var(--color-accent);
  }

  .site-footer__legal {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3) var(--space-4);
  }

  /* The rule spans the content width, like the rules inside the page, not the padding. */
  .site-footer__legal::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--grid-margin);
    right: var(--grid-margin);
    border-top: var(--hairline) solid var(--color-line);
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  @media (max-width: 767.98px) {
    .site-footer__id {
      grid-column: 1 / -1;
    }

    .site-footer__col {
      grid-column: span 6;
    }
  }

  @media (max-width: 479.98px) {
    .site-footer__col {
      grid-column: 1 / -1;
    }
  }
</style>
