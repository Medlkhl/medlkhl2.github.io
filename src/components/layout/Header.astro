---
/**
 * Sticky site header: name, main navigation, language switch and theme toggle.
 * - The current page is marked with aria-current="page"; on a case study the
 *   Work link gets aria-current="true" (its section, not the page itself).
 * - On the home page the link of the section in view is highlighted
 *   (IntersectionObserver; sections opt in with data-nav-target="<key>", and
 *   parts without a nav link carry an empty data-nav-target, which clears it).
 * - Mobile: a disclosure menu with JavaScript; without it the links wrap into a row.
 * Scripts bind on astro:page-load and clean up on astro:before-swap (ClientRouter).
 */
import { profile } from '../../data/profile.ts';
import { LOCALE_META, type Locale, otherLocale } from '../../i18n/config.ts';
import { localePath, routeHref, unlocalizePath } from '../../i18n/routes.ts';
import { ui } from '../../i18n/ui.copy.ts';
import { withBase } from '../../lib/url.ts';
import Icon from '../ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  /** Unlocalized path of the current page ('/about/'); null when the page has no locale twin. */
  path: string | null;
}

const { locale, path } = Astro.props;
const t = ui[locale];
const current = path ? unlocalizePath(path) : null;
const other = otherLocale(locale);
const switchHref = path ? withBase(localePath(other, path)) : null;

/** 'page' when the link is this page, 'true' when this page sits in the link's section. */
type NavCurrent = 'page' | 'true' | undefined;
type NavItem = { key: string; href: string; label: string; current: NavCurrent; section?: string };
const pageIf = (route: string): NavCurrent => (current === route ? 'page' : undefined);
const items: NavItem[] = [
  {
    key: 'work',
    href: routeHref(locale, 'work'),
    label: t.nav.work,
    current: current?.startsWith('/work/') ? (current === '/work/' ? 'page' : 'true') : undefined,
    section: 'work',
  },
  {
    key: 'experience',
    href: routeHref(locale, 'experience'),
    label: t.nav.experience,
    current: pageIf('/experience/'),
    section: 'experience',
  },
  { key: 'lab', href: routeHref(locale, 'lab'), label: t.nav.lab, current: pageIf('/lab/') },
  {
    key: 'about',
    href: routeHref(locale, 'about'),
    label: t.nav.about,
    current: pageIf('/about/'),
  },
  { key: 'cv', href: routeHref(locale, 'cv'), label: t.nav.cv, current: pageIf('/cv/') },
  {
    key: 'contact',
    href: routeHref(locale, 'home', 'contact'),
    label: t.nav.contact,
    current: undefined,
    section: 'contact',
  },
];
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a
      class="brand"
      href={routeHref(locale, 'home')}
      aria-current={current === '/' ? 'page' : undefined}
    >
      <span class="brand__name">{profile.name}</span>
      <span class="brand__role">{profile.role[locale]}</span>
    </a>

    {/* The toggle comes right before the nav it reveals, so the next Tab after
        opening reaches the links (disclosure pattern); CSS order keeps it last. */}
    <button
      type="button"
      class="menu-toggle js-only"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      data-label-open={t.nav.menu}
      data-label-close={t.nav.closeMenu}
    >
      <span class="menu-toggle__icon menu-toggle__icon--open">
        <Icon name="menu" size={20} />
      </span>
      <span class="menu-toggle__icon menu-toggle__icon--close">
        <Icon name="close" size={20} />
      </span>
      <span class="visually-hidden" data-menu-label>
        {t.nav.menu}
      </span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={t.nav.label} data-site-nav>
      <ul role="list" class="site-nav__list">
        {items.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={item.href}
              aria-current={item.current}
              data-nav-section={item.section}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__controls">
      {switchHref && (
        <a
          class="lang-switch"
          href={switchHref}
          hreflang={LOCALE_META[other].htmlLang}
          lang={LOCALE_META[other].htmlLang}
          data-lang-switch={other}
        >
          {t.language.switchText}
          <span class="visually-hidden"> ({t.language.switchLabel})</span>
        </a>
      )}
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--hairline) solid var(--color-line);
    background: var(--color-header);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-right: auto;
    padding-block: var(--space-1);
    text-decoration: none;
    line-height: 1.2;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__name {
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
  }

  .brand__role {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--color-text-subtle);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-half);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-1);
    right: var(--space-1);
    bottom: 0.55rem;
    height: var(--hairline);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-micro) var(--ease-micro);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current],
  .site-nav__link[data-active] {
    color: var(--color-text);
  }

  .site-nav__link[aria-current]::after,
  .site-nav__link[data-active]::after {
    transform: scaleX(1);
    background: var(--color-accent);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-half);
  }

  .lang-switch {
    display: inline-grid;
    place-items: center;
    min-width: var(--target);
    height: var(--target);
    border-radius: var(--radius-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .lang-switch:hover {
    color: var(--color-text);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--color-text);
  }

  .menu-toggle__icon {
    grid-area: 1 / 1;
    display: grid;
  }

  .menu-toggle[aria-expanded='false'] .menu-toggle__icon--close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .brand__role {
      display: none;
    }
  }

  @media (max-width: 859.98px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0 var(--space-1);
    }

    /* The brand holds the first row at header height, so opening the menu
       (the nav wraps below) neither shifts the row nor clips focus rings. */
    :global(.js) .brand {
      min-height: var(--header-height);
      justify-content: center;
    }

    /* Visual row: brand … language, theme, menu; the nav wraps below. The
       toggle sits before the nav in the source so the tab order follows it. */
    .site-header__controls {
      order: 1;
    }

    .menu-toggle {
      order: 2;
    }

    /* Without JavaScript the links wrap into rows below, every one in view. */
    .site-nav {
      order: 3;
      width: 100%;
      padding-bottom: var(--space-half);
    }

    .site-nav__list {
      flex-wrap: wrap;
    }

    :global(.js) .menu-toggle {
      display: inline-grid;
    }

    /* With JavaScript the second row becomes a disclosure panel. */
    :global(.js) .site-nav {
      display: none;
      padding: var(--space-1) 0 var(--space-2);
      border-top: var(--hairline) solid var(--color-line);
    }

    /* In a short (landscape) viewport the open panel scrolls on its own. */
    :global(.js) .site-nav[data-open] {
      display: block;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    :global(.js) .site-nav__list {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.js) .site-nav__link {
      width: 100%;
      font-size: var(--step-0);
    }

    :global(.js) .site-nav__link::after {
      display: none;
    }

    :global(.js) .site-nav__link[aria-current] {
      color: var(--color-accent);
    }
  }
</style>

<script>
  import { setPref } from '../../lib/prefs.ts';

  let observer: IntersectionObserver | undefined;

  function bindMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-site-nav]');
    const label = toggle?.querySelector<HTMLElement>('[data-menu-label]');
    if (!toggle || !nav || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      if (label)
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  function bindLanguageSwitch() {
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = link.dataset.langSwitch;
        if (target === 'en' || target === 'de') setPref('lang', target);
      });
    });
  }

  function bindSectionHighlight() {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-nav-target]')];
    if (!sections.length || !('IntersectionObserver' in window)) return;
    const links = document.querySelectorAll<HTMLElement>('[data-nav-section]');
    const last = sections[sections.length - 1];
    // Sections crossing a thin band just above the middle of the viewport, and
    // whether the last section has scrolled above it (the footer is in view).
    const inBand = new Set<Element>();
    let pastLast = false;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target);
          else inBand.delete(entry.target);
          if (entry.target === last)
            pastLast =
              !entry.isIntersecting &&
              entry.boundingClientRect.bottom <= (entry.rootBounds?.top ?? 0);
        }
        // The last crossing section in document order wins; an empty key (hero,
        // sections without a nav link) or no section at all clears the highlight.
        const crossing = sections.filter((section) => inBand.has(section));
        const current = crossing[crossing.length - 1] ?? (pastLast ? last : undefined);
        const key = current?.dataset.navTarget;
        links.forEach((link) =>
          link.toggleAttribute('data-active', Boolean(key) && link.dataset.navSection === key),
        );
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer?.observe(section));
  }

  document.addEventListener('astro:page-load', () => {
    bindMenu();
    bindLanguageSwitch();
    bindSectionHighlight();
  });

  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = undefined;
  });
</script>
