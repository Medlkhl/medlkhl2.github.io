---
/**
 * A reference section whose heading is the monospace label itself
 * ("01 — Timeline" as an h2), for dense content such as the timeline,
 * education, languages or credits. Narrative sections use ui/Section with a
 * full-size h2 instead. Shared by the Experience, About, Lab and Colophon views.
 *
 * layout "stack" (default): label above the body.
 * layout "side": from 48rem the label takes columns 1–3 and the body 4–12,
 * the same rhythm as the timeline entries.
 * The last section of a page drops its bottom padding (the footer brings its own gap).
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
  id: string;
  index?: number;
  label: string;
  layout?: 'stack' | 'side';
  /** Draw the hairline rule above the section (default: true unless bare). */
  rule?: boolean;
  /** No container, padding or rule (when nested in a grid that already has them). */
  bare?: boolean;
  class?: string;
}

const { id, index, label, layout = 'stack', bare = false, class: className } = Astro.props;
const rule = Astro.props.rule ?? !bare;
const headingId = `${id}-title`;
---

<section
  id={id}
  class:list={[
    'compact',
    `compact--${layout}`,
    { 'compact--rule': rule, 'compact--bare': bare },
    className,
  ]}
  aria-labelledby={headingId}
>
  <div class:list={['compact__inner', { container: !bare }]}>
    <SectionLabel as="h2" id={headingId} index={index} class="compact__label">
      {label}
    </SectionLabel>
    <div class="compact__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .compact {
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
  }

  .compact:last-child {
    padding-bottom: 0;
  }

  .compact--rule {
    border-top: var(--hairline) solid var(--color-line);
  }

  .compact--bare {
    padding-block: 0;
  }

  .compact__body {
    margin-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .compact--side .compact__inner {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gutter);
      align-items: baseline;
    }

    .compact--side :global(.compact__label) {
      grid-column: 1 / span 3;
    }

    .compact--side .compact__body {
      grid-column: 4 / -1;
      margin-top: 0;
    }
  }
</style>
