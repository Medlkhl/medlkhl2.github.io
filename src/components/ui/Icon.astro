---
import { ICON_PATHS, type IconName } from './icons.ts';

/**
 * Inline SVG icons (24×24 grid, 1.5px strokes) in the engineering-drawing style.
 * Decorative by default (aria-hidden). Pass `label` to expose an accessible name.
 */
interface Props {
  name: IconName;
  label?: string;
  size?: number;
  class?: string;
}

const { name, label, size = 16, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={ICON_PATHS[name]}></path>
</svg>
